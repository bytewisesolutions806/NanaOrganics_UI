NEXT_PUBLIC_VENDURE_CHANNEL_TOKEN=

# Stripe's browser-safe publishable key. Secret and webhook keys stay in Vendure.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
