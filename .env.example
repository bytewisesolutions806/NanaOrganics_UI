# Use the API URL reachable by the EC2 host during the image build.
VENDURE_SHOP_API_URL=https://staging-api.example.com/shop-api

# Leave empty for the default channel; otherwise use the matching Vendure channel token.
VENDURE_CHANNEL_TOKEN=

# Browser-side API URL and channel selection.
NEXT_PUBLIC_VENDURE_API_URL=https://staging-api.example.com/shop-api
NEXT_PUBLIC_VENDURE_CHANNEL_TOKEN=

# Stripe's browser-safe publishable key. Secret and webhook keys stay in Vendure.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
