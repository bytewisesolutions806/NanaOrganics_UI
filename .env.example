VENDURE_SHOP_API_URL=http://localhost:3000/shop-api

# Optional when the Vendure project uses a non-default channel.
VENDURE_CHANNEL_TOKEN=haj53ahxrkad9ghh9gb

# Kept for browser-side API clients that will be added later.
